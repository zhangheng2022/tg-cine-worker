{
	"name": "tg-cine-worker",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "wrangler dev --local",
		"types": "wrangler types --strict-vars=false",
		"check": "npm run types && tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:relay": "node scripts/verify-local-relay.mjs",
		"build": "wrangler deploy --dry-run --outdir dist"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@hono/cli": "^1.0.0-rc.6",
		"@types/node": "^24.0.0",
		"prettier": "^3.0.0",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "^4.149.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261006.1": true
	},
	"dependencies": {
		"hono": "^4.13.13"
	}
}
